{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:css",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/v1/public/:path*",
      "destination": "https://GANTI-DENGAN-URL-BACKEND-RENDER.onrender.com/api/v1/public/:path*"
    },
    {
      "source": "/health",
      "destination": "https://GANTI-DENGAN-URL-BACKEND-RENDER.onrender.com/health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
